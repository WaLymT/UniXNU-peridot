+static uint8_t  *peridot_fb;
+static uint32_t  peridot_fb_rowbytes;
+static uint32_t  peridot_fb_width;
+static uint32_t  peridot_fb_height;
+static uint32_t  peridot_fb_x;
+static uint32_t  peridot_fb_y;
+static boolean_t peridot_fb_ready;
+
+#define PERIDOT_FB_SCALE 2
+
+void
+peridot_fb_putc(char c)
+{
+	uint32_t row, col, dx, dy, px, py, data, cw = 6 * PERIDOT_FB_SCALE;
+	uint64_t glyph;
+	uint32_t top, bottom;
+
+	if (!peridot_fb_ready) {
+		if (PE_state.video.v_baseAddr == 0 || PE_state.video.v_rowBytes == 0 ||
+		    PE_state.video.v_height == 0) {
+			return;
+		}
+		peridot_fb = (uint8_t *)ml_io_map(PE_state.video.v_baseAddr,
+		    PE_state.video.v_rowBytes * PE_state.video.v_height);
+		peridot_fb_rowbytes = (uint32_t)PE_state.video.v_rowBytes;
+		peridot_fb_width = (uint32_t)PE_state.video.v_width;
+		peridot_fb_height = (uint32_t)PE_state.video.v_height;
+		peridot_fb_ready = TRUE;
+		if (peridot_fb == NULL) {
+			return;
+		}
+	}
+
+	if (c == '\r') {
+		peridot_fb_x = 0;
+		return;
+	}
+	if (c == '\n') {
+		peridot_fb_x = 0;
+		peridot_fb_y += 14 * PERIDOT_FB_SCALE;
+		goto scroll;
+	}
+	if (c < 32 || c > 127) {
+		c = '?';
+	}
+
+	glyph = peridot_font[(uint8_t)c - 32];
+	top = (uint32_t)(glyph >> 32);
+	bottom = (uint32_t)glyph;
+	for (row = 0; row < 12; row++) {
+		data = (row < 6) ? (top >> (row * 5)) : (bottom >> ((row - 6) * 5));
+		for (col = 0; col < 5; col++) {
+			px = peridot_fb_x + col * PERIDOT_FB_SCALE;
+			for (dy = 0; dy < PERIDOT_FB_SCALE; dy++) {
+				py = peridot_fb_y + row * PERIDOT_FB_SCALE + dy;
+				if (py >= peridot_fb_height) {
+					continue;
+				}
+				for (dx = 0; dx < PERIDOT_FB_SCALE; dx++) {
+					uint32_t *p;
+					if (px + dx >= peridot_fb_width) {
+						continue;
+					}
+					p = (uint32_t *)(peridot_fb +
+					    (uint64_t)py * peridot_fb_rowbytes +
+					    (uint64_t)(px + dx) * 4);
+					*p = ((data >> col) & 1) ? 0xFFFFFFFFu : 0xFF000000u;
+				}
+			}
+		}
+	}
+
+	peridot_fb_x += cw;
+	if (peridot_fb_x + cw >= peridot_fb_width) {
+		peridot_fb_x = 0;
+		peridot_fb_y += 14 * PERIDOT_FB_SCALE;
+	}
+scroll:
+	if (peridot_fb_y + 14 * PERIDOT_FB_SCALE >= peridot_fb_height) {
+		peridot_fb_y = 0;
+	}
+}
