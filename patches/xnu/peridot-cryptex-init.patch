--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1096,6 +1096,42 @@
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+	/* peridot: attach the SystemOS cryptex before launchd starts; it carries the dyld
+	 * shared cache that dyld needs for /sbin/launchd (see peridot-cryptex-graft.patch). */
+	{
+		extern int peridot_apfs_mount(const char *, const char *);
+		extern int peridot_path_probe(const char *, uint64_t *, unsigned *);
+		extern int peridot_cryptex_graft(const char *, const char *, uint32_t, uint32_t,
+		    uint64_t);
+		int peridotMountNoArgs = peridot_apfs_mount(NULL, "/System/Library/Caches");
+		int peridotMountDev = peridotMountNoArgs ? peridot_apfs_mount("/dev/nu1",
+		    "/System/Library/Caches") : 0;
+		int peridotGraft = peridotMountDev ? peridot_cryptex_graft("/dev/nu1",
+		    "/System/Library/Caches", 1, 0, 6) : 0;
+		printf("peridot-cryptex: mount noargs=%d dev=%d graft=%d\n",
+		    peridotMountNoArgs, peridotMountDev, peridotGraft);
+		static const char *peridotProbePaths[] = {
+			"/System/Library/Caches/com.apple.dyld",
+			"/System/Library/Caches/dyld_shared_cache_arm64",
+			"/System/Library/Caches/dyld_shared_cache_arm64e",
+			"/System/Library/Caches/System",
+			"/System/Library/Caches/usr",
+			"/System/Library/Caches/System/Library/Caches/com.apple.dyld",
+			"/System/Library/Caches/usr/lib",
+		};
+		for (unsigned peridotI = 0;
+		    peridotI < sizeof(peridotProbePaths) / sizeof(peridotProbePaths[0]); peridotI++) {
+			uint64_t peridotSize = 0;
+			unsigned peridotIno = 0;
+			int peridotErr = peridot_path_probe(peridotProbePaths[peridotI], &peridotSize,
+			    &peridotIno);
+			printf("peridot-cryptex: %s e=%d sz=%llu ino=%u\n", peridotProbePaths[peridotI],
+			    peridotErr, (unsigned long long)peridotSize, peridotIno);
+		}
+		panic("peridot-cryptex: mount probes done (noargs=%d dev=%d graft=%d)",
+		    peridotMountNoArgs, peridotMountDev, peridotGraft);
+	}
+
 	load_init_program(p);
 	lock_trace = 1;
 }
