--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1096,6 +1096,336 @@
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+	/* peridot: attach the SystemOS cryptex before launchd starts; it carries the dyld
+	 * shared cache that dyld needs for /sbin/launchd. See notes: p388/p389/p390.
+	 * mount_common() consumes the leading device-path pointer from the data blob, so the
+	 * APFS structure starts at +0x08 of the blob: u64 flags, u16 enum, u32, name[0x100]. */
+	{
+		extern int peridot_path_probe(const char *, uint64_t *, unsigned *);
+		unsigned peridotRootProbe = 0;
+		PE_parse_boot_argn("peridot-root-probe", &peridotRootProbe,
+		    sizeof(peridotRootProbe));
+		if (peridotRootProbe == 1) {
+			static const char *peridotRootPaths[] = {
+				"/sbin/launchd", "/usr/lib/dyld", "/apfs.fs",
+				"/apfs.fs/mount_apfs", "/sbin/mount_apfs",
+				"/usr/libexec/mount_apfs",
+			};
+			for (unsigned peridotR = 0;
+			    peridotR < sizeof(peridotRootPaths) / sizeof(peridotRootPaths[0]); peridotR++) {
+				uint64_t peridotRSize = 0;
+				unsigned peridotRIno = 0;
+				int peridotRErr = peridot_path_probe(peridotRootPaths[peridotR],
+				    &peridotRSize, &peridotRIno);
+				printf("peridot root: %s e=%d sz=%llu ino=%u\n", peridotRootPaths[peridotR],
+				    peridotRErr, (unsigned long long)peridotRSize, peridotRIno);
+			}
+			int peridotRootErrs[6];
+			for (unsigned peridotR2 = 0;
+			    peridotR2 < sizeof(peridotRootPaths) / sizeof(peridotRootPaths[0]); peridotR2++) {
+				uint64_t peridotS2 = 0;
+				unsigned peridotI2 = 0;
+				peridotRootErrs[peridotR2] = peridot_path_probe(
+				    peridotRootPaths[peridotR2], &peridotS2, &peridotI2);
+			}
+			panic("root ld=%d dyld=%d fs=%d mp=%d smp=%d ump=%d",
+			    peridotRootErrs[0], peridotRootErrs[1], peridotRootErrs[2],
+			    peridotRootErrs[3], peridotRootErrs[4], peridotRootErrs[5]);
+		}
+		unsigned peridotProbe = 0;
+		PE_parse_boot_argn("peridot-cryptex-probe", &peridotProbe,
+		    sizeof(peridotProbe));
+		if (peridotProbe == 5) {
+			/* Root is the iPadOS System container (proven); mount the writable staging APFS
+			 * container (/dev/nu2, formatted by probe 49) at /System/Library/Caches, copy the
+			 * SystemOS cryptex into a regular file there and graft that file vnode onto the
+			 * staging volume root. APFS copies mount arguments from user space, so those live
+			 * in a scratch page of the init process's map (p387/p388). */
+			extern int kernel_mount(const char *, vnode_t, vnode_t, const char *, void *,
+			    size_t, int, uint32_t, vfs_context_t);
+			extern int native_ufs_read_absolute(uint64_t, uint32_t, void *);
+			extern uint64_t nativeUfsCryptexLba;
+			extern errno_t vnode_open(const char *, int, int, int, vnode_t *,
+			    vfs_context_t);
+			extern int vnode_close(vnode_t, int, vfs_context_t);
+			extern void *IOMalloc(vm_size_t);
+			extern void IOFree(void *, vm_size_t);
+			extern int peridot_path_probe(const char *, uint64_t *, unsigned *);
+			extern int peridot_cryptex_graft(const char *, const char *, uint32_t,
+			    uint32_t, uint64_t);
+			vfs_context_t peridotCtx = vfs_context_kernel();
+			const char *peridotMnt = "/System/Library/Caches";
+			const char *peridotStageDev = "/dev/nu2";
+			const char *peridotCryptexFile = "/System/Library/Caches/cryptex.img";
+			int peridotMountErr = kernel_mount("apfs", NULLVP, NULLVP, peridotMnt, NULL, 0,
+			    MNT_RDONLY, KERNEL_MOUNT_NOAUTH, peridotCtx);
+			if (peridotMountErr != 0) {
+				vm_map_t peridotMap = current_map();
+				mach_vm_offset_t peridotScratch = 0;
+				mach_vm_size_t peridotPage = vm_map_page_size(peridotMap);
+				if (mach_vm_allocate_kernel(peridotMap, &peridotScratch, peridotPage, 1, 0) == 0) {
+					user_addr_t peridotDevVA = peridotScratch + 0x148;
+					user_addr_t peridotFsVA = peridotDevVA + 16;
+					user_addr_t peridotMntVA = peridotFsVA + 8;
+					user_addr_t peridotBlobVA = peridotScratch + 0x200;
+					uint8_t peridotBlob[0x148];
+					copyout(peridotStageDev, peridotDevVA, strlen(peridotStageDev) + 1);
+					copyout("apfs", peridotFsVA, 5);
+					copyout(peridotMnt, peridotMntVA, strlen(peridotMnt) + 1);
+					/* The captured mount_apfs blob (p407) is: fspec pointer, then
+					 * u64 mount flags = 0, u16 = 1, and zeros - so try that layout first
+					 * (rw and readonly), then the other u16 values as a fallback. */
+					for (unsigned peridotV = 0; peridotV < 10 && peridotMountErr != 0;
+					    peridotV++) {
+						memset(peridotBlob, 0, sizeof(peridotBlob));
+						*(uint64_t *)peridotBlob = peridotDevVA;
+						*(uint64_t *)(peridotBlob + 0x08) = (peridotV == 1) ? MNT_RDONLY : 0;
+						*(uint16_t *)(peridotBlob + 0x10) = (peridotV <= 1) ? 1 : (uint16_t)peridotV;
+						copyout(peridotBlob, peridotBlobVA, sizeof(peridotBlob));
+						peridotMountErr = kernel_mount("apfs", NULLVP, NULLVP, peridotMnt,
+						    (void *)(uintptr_t)peridotBlobVA, sizeof(peridotBlob),
+						    (peridotV == 1) ? MNT_RDONLY : 0, KERNEL_MOUNT_NOAUTH,
+						    peridotCtx);
+					}
+				}
+			}
+			int peridotOpenErr = -1;
+			int peridotCopyErr = 0;
+			uint64_t peridotCopied = 0;
+			int peridotGraftErr = -1;
+			if (peridotMountErr == 0) {
+				vnode_t peridotFileVp = NULLVP;
+				peridotOpenErr = vnode_open(peridotCryptexFile,
+				    0x03 | 0x0200 /* FREAD|FWRITE|O_CREAT */ | 0x0400 /* O_TRUNC */, 0644,
+				    0, &peridotFileVp, peridotCtx);
+				if (peridotOpenErr == 0) {
+					const vm_size_t peridotChunk = 1ULL << 20;
+					const uint64_t peridotCryptexBytes = 3303014400ULL;
+					uint8_t *peridotBuf = (uint8_t *)IOMalloc(peridotChunk);
+					if (!peridotBuf) {
+						peridotCopyErr = ENOMEM;
+					} else {
+						while (peridotCopied < peridotCryptexBytes) {
+							uint32_t peridotWant = (uint32_t)((peridotCryptexBytes - peridotCopied) < peridotChunk
+							    ? (peridotCryptexBytes - peridotCopied) : peridotChunk);
+							uint32_t peridotBlocks = (peridotWant + 4095) / 4096;
+							if (native_ufs_read_absolute(nativeUfsCryptexLba + (peridotCopied >> 12),
+							    peridotBlocks, peridotBuf) != 0) {
+								peridotCopyErr = EIO;
+								break;
+							}
+							int peridotResid = 0;
+							int peridotWErr = vn_rdwr(1 /* UIO_WRITE */, peridotFileVp,
+							    (caddr_t)peridotBuf, (int)peridotWant, (off_t)peridotCopied,
+							    0 /* UIO_SYSSPACE */, 0,
+							    vfs_context_ucred(peridotCtx), &peridotResid,
+							    current_proc());
+							if (peridotWErr || peridotResid) {
+								peridotCopyErr = peridotWErr ? peridotWErr : EIO;
+								break;
+							}
+							peridotCopied += peridotWant;
+						}
+						IOFree(peridotBuf, peridotChunk);
+					}
+					vnode_close(peridotFileVp, 0x03, peridotCtx);
+				}
+				if (peridotOpenErr == 0 && peridotCopyErr == 0) {
+					peridotGraftErr = peridot_cryptex_graft(peridotCryptexFile,
+					    peridotMnt, 1, 0, 6);
+				}
+			}
+			uint64_t peridotGSize = 0;
+			unsigned peridotGIno = 0;
+			int peridotGE1 = peridot_path_probe("/System/Library/Caches/com.apple.dyld",
+			    &peridotGSize, &peridotGIno);
+			peridotGSize = 0;
+			int peridotGE2 = peridot_path_probe("/System/Library/Caches/System",
+			    &peridotGSize, &peridotGIno);
+			peridotGSize = 0;
+			int peridotGE3 = peridot_path_probe("/System/Library/Caches/usr/lib",
+			    &peridotGSize, &peridotGIno);
+			panic("peridot-cryptex: file-graft2 mount=%d open=%d copy=%d/%llu graft=%d e1=%d e2=%d e3=%d",
+			    peridotMountErr, peridotOpenErr, peridotCopyErr,
+			    (unsigned long long)peridotCopied, peridotGraftErr, peridotGE1,
+			    peridotGE2, peridotGE3);
+		}
+
+		if (peridotProbe == 4) {
+			/* Copy the staged SystemOS cryptex container (/dev/nu1 region) into a regular
+			 * file on the writable staging volume (probe 51 roots from the APFS container
+			 * formatted by probe 49), then graft that file vnode - the form the real
+			 * graft flow uses (p400: a block-device vnode panics inside APFS). */
+			extern uint64_t nativeUfsCryptexLba;
+			extern int native_ufs_read_absolute(uint64_t, uint32_t, void *);
+			extern errno_t vnode_open(const char *, int, int, int, vnode_t *,
+			    vfs_context_t);
+			extern int vnode_close(vnode_t, int, vfs_context_t);
+						extern void *IOMalloc(vm_size_t);
+			extern void IOFree(void *, vm_size_t);
+			extern int peridot_path_probe(const char *, uint64_t *, unsigned *);
+			vfs_context_t peridotCtx = vfs_context_kernel();
+			kauth_cred_t peridotCred = vfs_context_ucred(peridotCtx);
+			vnode_t peridotFileVp = NULLVP;
+			const vm_size_t peridotChunk = 1ULL << 20;
+			const uint64_t peridotCryptexBytes = 3303014400ULL;
+			errno_t peridotOpenErr = vnode_open("/cryptex.img",
+			    0x03 | 0x0200 /* FREAD|FWRITE|O_CREAT */ | 0x0400 /* O_TRUNC */, 0644,
+			    0 /* lookup flags */, &peridotFileVp, peridotCtx);
+			int peridotCopyErr = 0;
+			uint64_t peridotCopied = 0;
+			if (peridotOpenErr == 0) {
+				uint8_t *peridotBuf = (uint8_t *)IOMalloc(peridotChunk);
+				if (!peridotBuf) {
+					peridotCopyErr = ENOMEM;
+				} else {
+					while (peridotCopied < peridotCryptexBytes) {
+						uint32_t peridotWant = (uint32_t)((peridotCryptexBytes - peridotCopied) < peridotChunk
+						    ? (peridotCryptexBytes - peridotCopied) : peridotChunk);
+						uint32_t peridotBlocks = (peridotWant + 4095) / 4096;
+						if (native_ufs_read_absolute(nativeUfsCryptexLba + (peridotCopied >> 12),
+						    peridotBlocks, peridotBuf) != 0) {
+							peridotCopyErr = EIO;
+							break;
+						}
+						int peridotResid = 0;
+						int peridotWErr = vn_rdwr(1 /* UIO_WRITE */, peridotFileVp,
+						    (caddr_t)peridotBuf, (int)peridotWant, (off_t)peridotCopied,
+						    0 /* UIO_SYSSPACE */, 0, peridotCred, &peridotResid, current_proc());
+						if (peridotWErr || peridotResid) {
+							peridotCopyErr = peridotWErr ? peridotWErr : EIO;
+							break;
+						}
+						peridotCopied += peridotWant;
+					}
+					IOFree(peridotBuf, peridotChunk);
+				}
+				vnode_close(peridotFileVp, 0x03, peridotCtx);
+			}
+			extern int peridot_cryptex_graft(const char *, const char *, uint32_t,
+			    uint32_t, uint64_t);
+			int peridotGraftErr = (peridotOpenErr == 0 && peridotCopyErr == 0)
+			    ? peridot_cryptex_graft("/cryptex.img", "/", 1, 0, 6) : -1;
+			uint64_t peridotGSize = 0;
+			unsigned peridotGIno = 0;
+			int peridotGE1 = peridot_path_probe("/com.apple.dyld", &peridotGSize,
+			    &peridotGIno);
+			peridotGSize = 0;
+			int peridotGE2 = peridot_path_probe("/System", &peridotGSize, &peridotGIno);
+			peridotGSize = 0;
+			int peridotGE3 = peridot_path_probe("/usr/lib", &peridotGSize,
+			    &peridotGIno);
+			panic("peridot-cryptex: file-graft open=%d copy=%d/%llu graft=%d e1=%d e2=%d e3=%d",
+			    peridotOpenErr, peridotCopyErr,
+			    (unsigned long long)peridotCopied, peridotGraftErr, peridotGE1,
+			    peridotGE2, peridotGE3);
+		}
+
+		if (peridotProbe == 2 || peridotProbe == 3) {
+		vm_map_t peridotMap = current_map();
+		mach_vm_offset_t peridotScratch = 0;
+		mach_vm_size_t peridotPage = vm_map_page_size(peridotMap);
+		kern_return_t peridotAlloc = mach_vm_allocate_kernel(peridotMap,
+		    &peridotScratch, peridotPage, 1 /* VM_FLAGS_ANYWHERE */, 0);
+		const char *peridotDev = "/dev/nu1";
+		const char *peridotMnt = "/System/Library/Caches";
+		const char *peridotVolName = "DawnUpdate21H461.J120J121J207J208SystemCryptex";
+		int peridotV16[9];
+		int peridotName[2][2];
+		const char *peridotMounted = "(none)";
+		for (unsigned peridotI = 0; peridotI < 9; peridotI++) {
+			peridotV16[peridotI] = -1;
+		}
+		for (unsigned peridotA = 0; peridotA < 2; peridotA++) {
+			for (unsigned peridotB = 0; peridotB < 2; peridotB++) {
+				peridotName[peridotA][peridotB] = -1;
+			}
+		}
+		int peridotMountError = -1;
+		if (peridotAlloc == 0 && peridotProbe == 2) {
+			user_addr_t peridotDevVA = peridotScratch + 0x148;
+			user_addr_t peridotMntVA = peridotDevVA + 16;
+			user_addr_t peridotBlobVA = peridotScratch + 0x200;
+			uint8_t peridotBlob[0x148];
+			copyout(peridotDev, peridotDevVA, strlen(peridotDev) + 1);
+			copyout(peridotMnt, peridotMntVA, strlen(peridotMnt) + 1);
+			for (unsigned peridotV = 0; peridotV < 9; peridotV++) {
+				memset(peridotBlob, 0, sizeof(peridotBlob));
+				*(uint64_t *)peridotBlob = peridotDevVA;
+				*(uint64_t *)(peridotBlob + 0x08) = MNT_RDONLY;
+				*(uint16_t *)(peridotBlob + 0x10) = (uint16_t)peridotV;
+				*(uint32_t *)(peridotBlob + 0x18) = 4096;
+				copyout(peridotBlob, peridotBlobVA, sizeof(peridotBlob));
+				peridotV16[peridotV] = kernel_mount("apfs", NULLVP, NULLVP, peridotMnt,
+				    (void *)(uintptr_t)peridotBlobVA, sizeof(peridotBlob), MNT_RDONLY,
+				    KERNEL_MOUNT_NOAUTH, vfs_context_kernel());
+				if (peridotV16[peridotV] == 0) {
+					peridotMounted = peridotMnt;
+					break;
+				}
+			}
+			if (peridotMounted[0] == '(') {
+				for (unsigned peridotA = 0; peridotA < 2; peridotA++) {
+					for (unsigned peridotB = 0; peridotB < 2; peridotB++) {
+						memset(peridotBlob, 0, sizeof(peridotBlob));
+						*(uint64_t *)peridotBlob = peridotDevVA;
+						*(uint64_t *)(peridotBlob + 0x08) = peridotB ? 0 : MNT_RDONLY;
+						*(uint16_t *)(peridotBlob + 0x10) = 5;
+						*(uint32_t *)(peridotBlob + 0x18) = peridotA ? 4096 : 512;
+						copyout(peridotBlob, peridotBlobVA, sizeof(peridotBlob));
+						if (peridotA) {
+							copyout(peridotVolName, peridotBlobVA + 0x1c,
+							    strlen(peridotVolName) + 1);
+						}
+						peridotName[peridotA][peridotB] = kernel_mount("apfs", NULLVP,
+						    NULLVP, peridotMnt, (void *)(uintptr_t)peridotBlobVA,
+						    sizeof(peridotBlob), MNT_RDONLY, KERNEL_MOUNT_NOAUTH,
+						    vfs_context_kernel());
+						if (peridotName[peridotA][peridotB] == 0) {
+							peridotMounted = peridotMnt;
+							peridotMountError = 0;
+							break;
+						}
+						peridotMountError = peridotName[peridotA][peridotB];
+					}
+					if (peridotMounted[0] != '(') {
+						break;
+					}
+				}
+			}
+		}
+		char peridotGraftMnt[128] = "";
+		unsigned peridotGraftType = 1, peridotGraft4cc = 0, peridotGraftFlags = 0;
+		PE_parse_boot_argn("peridot-graft-mnt", peridotGraftMnt, sizeof(peridotGraftMnt));
+		PE_parse_boot_argn("peridot-graft-type", &peridotGraftType, sizeof(peridotGraftType));
+		PE_parse_boot_argn("peridot-graft-4cc", &peridotGraft4cc, sizeof(peridotGraft4cc));
+		PE_parse_boot_argn("peridot-graft-flags", &peridotGraftFlags, sizeof(peridotGraftFlags));
+		extern int peridot_cryptex_graft(const char *, const char *, uint32_t, uint32_t,
+		    uint64_t);
+		int peridotGraftErr = peridot_cryptex_graft("/dev/nu1",
+		    peridotGraftMnt[0] ? peridotGraftMnt : NULL, peridotGraftType,
+		    peridotGraft4cc, peridotGraftFlags);
+		uint64_t peridotGSize = 0;
+		unsigned peridotGIno = 0;
+		int peridotE1 = peridot_path_probe(
+		    "/System/Library/Caches/com.apple.dyld", &peridotGSize, &peridotGIno);
+		peridotGSize = 0;
+		int peridotE2 = peridot_path_probe(
+		    "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64e",
+		    &peridotGSize, &peridotGIno);
+		peridotGSize = 0;
+		int peridotE3 = peridot_path_probe("/System/Cryptexes/OS", &peridotGSize,
+		    &peridotGIno);
+		peridotGSize = 0;
+		int peridotE4 = peridot_path_probe("/usr/lib/libSystem.B.dylib", &peridotGSize,
+		    &peridotGIno);
+		panic("peridot-cryptex: probe2 alloc=%d mount=%d graft=%d mnt=%s dl=%d/%llu "
+		    "e1=%d e2=%d e3=%d e4=%d", (int)peridotAlloc, peridotMountError,
+		    peridotGraftErr, peridotGraftMnt, peridotE1,
+		    (unsigned long long)peridotGSize, peridotE2, peridotE3, peridotE4);
+		}
+	}
+
 	load_init_program(p);
 	lock_trace = 1;
 }
