+	/* peridot: extra argv entries for the init program (peridot-init-arg1..5). */
+	int peridot_extra_count = 0;
+	user_addr_t peridot_extra[5] = { USER_ADDR_NULL, USER_ADDR_NULL, USER_ADDR_NULL, USER_ADDR_NULL, USER_ADDR_NULL };
+	for (int peridot_arg = 0; peridot_arg < 5; peridot_arg++) {
+		char peridot_name[32];
+		char peridot_value[128];
+		snprintf(peridot_name, sizeof(peridot_name), "peridot-init-arg%d", peridot_arg + 1);
+		if (!PE_parse_boot_argn(peridot_name, peridot_value, sizeof(peridot_value))) {
+			break;
+		}
+		printf("peridot init arg %d=%s\n", peridot_arg, peridot_value);
+		size_t peridot_length = strlen(peridot_value) + 1;
+		peridot_extra[peridot_extra_count] = scratch_addr;
+		error = copyout(peridot_value, scratch_addr, peridot_length);
 		if (error) {
 			return error;
 		}
+		scratch_addr = USER_ADDR_ALIGN(scratch_addr + peridot_length, sizeof(user_addr_t));
+		peridot_extra_count++;
+	}
+
+	if (proc_is64bit(p)) {
+		user64_addr_t argv64bit[7] = {};
+		int argv_index = 0;
+
+		argv64bit[argv_index++] = argv0;
+		if (argv1 != USER_ADDR_NULL) {
+			argv64bit[argv_index++] = argv1;
+		}
+		for (int peridot_arg = 0; peridot_arg < peridot_extra_count; peridot_arg++) {
+			argv64bit[argv_index++] = peridot_extra[peridot_arg];
+		}
+
+		error = copyout(argv64bit, scratch_addr, sizeof(user64_addr_t) * (argv_index + 1));
+		if (error) {
+			return error;
+		}
 	} else {
