+
+	/* peridot: boot-argument override of the init program (install work needs Apple tools,
+	 * and the restore ramdisk's launchd cannot be changed because the root is read-only). */
+	char peridot_init_path[128];
+	if (PE_parse_boot_argn("peridot-init-path", peridot_init_path, sizeof(peridot_init_path))) {
+		printf("load_init_program: peridot init path %s\n", peridot_init_path);
+		error = load_init_program_at_path(p, (user_addr_t)scratch_addr, peridot_init_path, init_envp);
+		if (!error) {
+			return;
+		}
+		panic("peridot: init program %s failed, errno %d", peridot_init_path, error);
+	}
 
