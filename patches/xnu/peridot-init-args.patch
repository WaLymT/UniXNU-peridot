-
-		argv32bit[0] = (user32_addr_t)argv0;
-		argv32bit[1] = (user32_addr_t)argv1;
-		argv32bit[2] = USER_ADDR_NULL;
-
-		error = copyout(argv32bit, scratch_addr, sizeof(argv32bit));
+		user32_addr_t argv32bit[7] = {};
+		int argv_index = 0;
+
+		argv32bit[argv_index++] = (user32_addr_t)argv0;
+		if (argv1 != USER_ADDR_NULL) {
+			argv32bit[argv_index++] = (user32_addr_t)argv1;
+		}
+		for (int peridot_arg = 0; peridot_arg < peridot_extra_count; peridot_arg++) {
