+extern const int nblkdev;
+
+// peridot: the root may be a bdevsw disk registered directly by the platform UFS
+// driver (drivers/ShengUfs/NativeUfs.cpp). Such a device never shows up as an
+// IOMedia, so the wait below cannot succeed; when the driver claims it, IOFindBSDRoot
+// adopts it instead of timing out.
+extern dev_t rootdev;
+extern uint64_t native_ufs_bdev_absolute;
+extern uint64_t native_ufs_bdev_bytes;
+// The bdevsw slot the driver registered, and the flag that says "use it as the root".
+extern int native_ufs_bdev_slot;
+extern int native_ufs_bdev_claim_root;
+
+// rootdev in this kernel is reset to NODEV somewhere between IOKit start-up and setconf
+// (p364: claim=1 rootdev=-1), so the adopted device is built from the exported slot.
+static dev_t
+peridotBdevswRootDev(void)
+{
+	int slot = native_ufs_bdev_slot;
+
+	if (!native_ufs_bdev_claim_root || slot < 0 || slot >= nblkdev) {
+		return NODEV;
+	}
+	if (bdevsw[slot].d_open == NULL || bdevsw[slot].d_open == eno_opcl) {
+		return NODEV;
+	}
+	return makedev(slot, 0);
+}
+
+static boolean_t
+peridotBdevswRootReady(void)
+{
+	return peridotBdevswRootDev() != NODEV;
+}
