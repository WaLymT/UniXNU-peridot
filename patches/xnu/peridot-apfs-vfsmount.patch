+/* peridot: mount the APFS volume directly instead of through apfs_vfsop_mountroot(),
+ * which mounts the sealed root snapshot. The IPSW image on this port has no such
+ * snapshot; mounting the volume itself is what proves the storage path. */
+static int peridot_apfs_vfsmount = -1;
+
+static boolean_t
+peridot_apfs_vfsmount_enabled(void)
+{
+	if (peridot_apfs_vfsmount < 0) {
+		int value = 0;
+		PE_parse_boot_argn("peridot-apfs-vfsmount", &value, sizeof(value));
+		peridot_apfs_vfsmount = value == 1;
+	}
+	return peridot_apfs_vfsmount != 0;
+}
