# peridot kernel configuration.
#
# The ARM64 fragment already sets BUILD_ARCHIVES, ARM_DT_PLATFORM, ARMCPU,
# NATIVE_AES, NATIVE_ARCH_TIMER and NATIVE_PAN. The OS fragment sets
# TRUST_CACHE_RUNTIME, SOURCE_MOCKFS, NATIVE_CS_HASH_CACHE and
# CRYPTO_BOOTSTRAP. Only board deltas belong here.
#
# Nothing is enabled yet: this board has no storage, display, input or GPU
# implementation selected. Add each flag together with its component and its
# porting record entry.

# Storage: enable once a UFS implementation covers the cliffs PHY and the MCQ
# register set.
# Qualcomm UFS root transport (vendored under drivers/ShengUfs).
#
# The binding step now exists: scripts/build-ufs-bindings.py derives
# IOBlockStorageDevice's addresses from this kernel's prelink and folds them into
# libShengUfs.a (the archives list wires it after component:ShengUfs). Read the
# note in that script before trusting a write path on this board.
CONFIG_XNU_NATIVE_UFS=y

# Display: enable together with the GopFramebuffer component.
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set

# No VirtIO or RAM block device on this board.
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set

# AMFI waits for an ApplePMGRNub and panics with "AMFI: No PMGR?" without one.
# The shared sheng-platform-power patch calls sheng_pmgr_run(), and the board
# package publishes the original provider through the guarded ABI instrument.
CONFIG_XNU_SHENG_PMGR=y
# Keep the prelink candidate and its record: the guarded original-ABI audits read
# build/xnu-prelink instead of rebuilding one.
CONFIG_XNU_KEEP_PRELINK_CANDIDATE=y

CONFIG_XNU_ARMVIRT_PLATFORM=n

# The OS profile compiles xnu with CONFIG_XNU_SOURCE_MOCKFS=y, so vfs_conf.o
# references the mockfs symbols. xnu_env() only exports XNU_* keys from THIS
# file, so without this line the build script never links the fixture archive
# and the kernel fails to link with three undefined mockfs symbols.
CONFIG_XNU_SOURCE_MOCKFS=y

# 2026-11-15: mockfs is the RAM-disk root of the bring-up path (a Mach-O placed at the
# start of the root device becomes /sbin/launchd). Last line wins in xnu_env(), so it
# must stay =y here.
CONFIG_XNU_SOURCE_MOCKFS=y